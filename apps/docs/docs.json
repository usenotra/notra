{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Notra Documentation",
  "description": "Documentation for Notra: track your brand across AI answer engines and turn your team's work into content.",
  "colors": {
    "primary": "#8b5cf6",
    "light": "#8b5cf6",
    "dark": "#8b5cf6"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/",
      "destination": "/quickstart",
      "permanent": false
    },
    {
      "source": "/api",
      "destination": "/api/getting-started"
    },
    {
      "source": "/api-reference/openapi.json",
      "destination": "https://api.usenotra.com/openapi.json",
      "permanent": false
    },
    {
      "source": "/sdk/getting-started",
      "destination": "/api/getting-started"
    },
    {
      "source": "/integrations/mcp",
      "destination": "/devtools/mcp"
    },
    {
      "source": "/integrations/featul",
      "destination": "/integrations/overview"
    },
    {
      "source": "/api/rust-sdk",
      "destination": "/api/getting-started"
    },
    {
      "source": "/concepts/how-it-works",
      "destination": "/geo/how-scans-work"
    },
    {
      "source": "/geo/overview",
      "destination": "/geo/product-map"
    },
    {
      "source": "/geo/prompts-and-competitors",
      "destination": "/geo/prompts"
    },
    {
      "source": "/geo/content-gaps-and-writer",
      "destination": "/geo/content-gaps"
    },
    {
      "source": "/geo/settings",
      "destination": "/geo/brand-and-domains"
    },
    {
      "source": "/overview",
      "destination": "/quickstart"
    },
    {
      "source": "/geo/traffic",
      "destination": "/ai-traffic/overview"
    },
    {
      "source": "/geo/ai-traffic/:slug*",
      "destination": "/ai-traffic/:slug*"
    },
    {
      "source": "/api/agent-feedback",
      "destination": "/feedback/send-feedback"
    },
    {
      "source": "/geo/playbooks/:slug*",
      "destination": "/playbooks/:slug*"
    },
    {
      "source": "/geo/troubleshooting/no-ai-traffic",
      "destination": "/ai-traffic/troubleshooting/no-ai-traffic"
    },
    {
      "source": "/geo/dashboard",
      "destination": "/geo/product-map"
    },
    {
      "source": "/sites/domains",
      "destination": "/sites/domains/overview"
    },
    {
      "source": "/sites/components",
      "destination": "/sites/components/overview"
    },
    {
      "source": "/sites/customize",
      "destination": "/sites/customize/design"
    }
  ],
  "api": {
    "url": "full"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "metatags": {
      "twitter:site": "@usenotra"
    }
  },
  "search": {
    "prompt": "Search the Notra docs..."
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page is on a content pipeline of its own",
      "description": "Looks like this page hasn't shipped yet. Try the [quickstart](/quickstart) or the [product map](/geo/product-map)."
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "chatgpt",
      "claude",
      "cursor"
    ],
    "display": "header"
  },
