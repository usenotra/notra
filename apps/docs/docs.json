{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Notra Documentation",
  "description": "Documentation for Notra: track your brand across AI answer engines and turn your team's work into content.",
  "colors": {
    "primary": "#8b5cf6",
    "light": "#8b5cf6",
    "dark": "#8b5cf6"
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/",
      "destination": "/overview"
    },
    {
      "source": "/api",
      "destination": "/api/getting-started"
    },
    {
      "source": "/api-reference/openapi.json",
      "destination": "https://api.usenotra.com/openapi.json",
      "permanent": false
    },
    {
      "source": "/sdk/getting-started",
      "destination": "/api/getting-started"
    },
    {
      "source": "/integrations/mcp",
      "destination": "/devtools/mcp"
    }
  ],
  "api": {
    "url": "full"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "metatags": {
      "twitter:site": "@usenotra"
    }
  },
  "search": {
    "prompt": "Search the Notra docs..."
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page is on a content pipeline of its own",
      "description": "Looks like this page hasn't shipped yet. Try the [quickstart](/quickstart) or head back to the [overview](/overview)."
    }
  },
  "contextual": {
    "options": ["copy", "assistant", "mcp", "chatgpt", "claude", "perplexity"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["overview", "quickstart"]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/content-pipeline",
              "concepts/brand-voice"
            ]
          },
          {
            "group": "GEO",
            "pages": [
              "geo/overview",
              "geo/prompts-and-competitors",
              "geo/traffic",
              "geo/agent-readiness",
              "geo/content-gaps-and-writer"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/github",
              "integrations/linear",
              "integrations/slack",
              "integrations/granola",
              "integrations/google-search-console",
              "integrations/framer",
              "integrations/featul",
              "integrations/kontentspace"
            ]
          },
          {
            "group": "Developer Tools",
            "pages": ["devtools/cli", "devtools/mcp", "devtools/raycast"]
          },
          {
            "group": "Automation",
            "pages": [
              "automation/overview",
              "automation/event-based",
              "automation/scheduled"
            ]
          },
          {
            "group": "Content Types",
            "pages": [
              "content/changelogs",
              "content/blog-posts",
              "content/social-media"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "organization/workspace-setup",
              "organization/team-management",
              "organization/billing"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api/getting-started",
              "api/authentication",
              "api/rate-limits"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "api/rust-sdk",
              "api/caching",
              "api/common-tasks",
              "api/pagination",
              "api/types",
              "api/agent-feedback"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api/webhooks/overview",
              "api/webhooks/events",
              "api/webhooks/outbound"
            ]
          },
          {
            "group": "Endpoints",
            "expanded": true,
            "openapi": {
              "source": "https://api.usenotra.com/openapi.json",
              "directory": "api-reference"
            },
            "pages": [
              {
                "group": "Discovery",
                "expanded": true,
                "pages": ["GET /v1/status"]
              },
              {
                "group": "Posts",
                "expanded": true,
                "pages": [
                  "GET /v1/posts",
                  "GET /v1/posts/{postId}",
                  "PATCH /v1/posts/{postId}",
                  "DELETE /v1/posts/{postId}",
                  {
                    "group": "Generation",
                    "expanded": true,
                    "pages": [
                      "POST /v1/posts/generate",
                      "GET /v1/posts/generate/{jobId}"
                    ]
                  }
                ]
              },
              {
                "group": "Brand Identities",
                "expanded": true,
                "pages": [
                  "GET /v1/brand-identities",
                  "GET /v1/brand-identities/{brandIdentityId}",
                  "PATCH /v1/brand-identities/{brandIdentityId}",
                  "DELETE /v1/brand-identities/{brandIdentityId}",
                  {
                    "group": "Generation",
                    "expanded": true,
                    "pages": [
                      "POST /v1/brand-identities/generate",
                      "GET /v1/brand-identities/generate/{jobId}"
                    ]
                  }
                ]
              },
              {
                "group": "Integrations",
                "expanded": true,
                "pages": [
                  "GET /v1/integrations",
                  "POST /v1/integrations/github",
                  "DELETE /v1/integrations/{integrationId}"
                ]
              },
              {
                "group": "Schedules",
                "expanded": true,
                "pages": [
                  "GET /v1/schedules",
                  "POST /v1/schedules",
                  "PATCH /v1/schedules/{scheduleId}",
                  "DELETE /v1/schedules/{scheduleId}"
                ]
              },
              {
                "group": "Event Triggers",
                "expanded": true,
                "pages": [
                  "GET /v1/event-triggers",
                  "POST /v1/event-triggers",
                  "GET /v1/event-triggers/{triggerId}",
                  "PATCH /v1/event-triggers/{triggerId}",
                  "DELETE /v1/event-triggers/{triggerId}"
                ]
              },
              {
                "group": "Skills",
                "expanded": true,
                "pages": [
                  "GET /v1/skills",
                  "POST /v1/skills",
                  "GET /v1/skills/{name}",
                  "PATCH /v1/skills/{name}",
                  "DELETE /v1/skills/{name}"
                ]
              },
              {
                "group": "Chats",
                "expanded": true,
                "pages": [
                  "GET /v1/chats",
                  "POST /v1/chats",
                  "GET /v1/chats/by-external",
                  "GET /v1/chats/{chatId}",
                  "POST /v1/chats/{chatId}"
                ]
              },
              {
                "group": "Feedback",
                "expanded": true,
                "pages": [
                  "POST /v1/feedback/{organizationSlug}",
                  "POST /v1/feedback",
                  "GET /v1/feedback",
                  "GET /v1/feedback/{feedbackId}",
                  "PATCH /v1/feedback/{feedbackId}"
                ]
              },
              {
                "group": "GEO",
                "expanded": true,
                "pages": [
                  {
                    "group": "Projects",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects",
                      "POST /v1/projects",
                      "GET /v1/projects/{projectId}",
                      "PATCH /v1/projects/{projectId}",
                      "DELETE /v1/projects/{projectId}"
                    ]
                  },
                  {
                    "group": "Settings",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/settings",
                      "PATCH /v1/projects/{projectId}/geo/settings"
                    ]
                  },
                  {
                    "group": "Prompts",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/prompts",
                      "POST /v1/projects/{projectId}/geo/prompts",
                      "PATCH /v1/projects/{projectId}/geo/prompts/{promptId}",
                      "DELETE /v1/projects/{projectId}/geo/prompts/{promptId}",
                      "POST /v1/projects/{projectId}/geo/prompts/import"
                    ]
                  },
                  {
                    "group": "Sequences",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/sequences",
                      "POST /v1/projects/{projectId}/geo/sequences",
                      "PATCH /v1/projects/{projectId}/geo/sequences/{sequenceId}",
                      "DELETE /v1/projects/{projectId}/geo/sequences/{sequenceId}",
                      "POST /v1/projects/{projectId}/geo/sequences/{sequenceId}/run"
                    ]
                  },
                  {
                    "group": "Competitors",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/competitors",
                      "PUT /v1/projects/{projectId}/geo/competitors",
                      "GET /v1/projects/{projectId}/geo/competitors/suggestions",
                      "DELETE /v1/projects/{projectId}/geo/competitors/{name}",
                      "POST /v1/projects/{projectId}/geo/competitors/import"
                    ]
                  },
                  {
                    "group": "Scans",
                    "expanded": true,
                    "pages": [
                      "POST /v1/projects/{projectId}/geo/scans",
                      "GET /v1/projects/{projectId}/geo/scans",
                      "GET /v1/projects/{projectId}/geo/scans/{scanId}"
                    ]
                  },
                  {
                    "group": "Visibility",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/visibility/overview",
                      "GET /v1/projects/{projectId}/geo/visibility/timeseries",
                      "GET /v1/projects/{projectId}/geo/visibility/prompt-results",
                      "GET /v1/projects/{projectId}/geo/visibility/competitor-share",
                      "GET /v1/projects/{projectId}/geo/visibility/language-share",
                      "GET /v1/projects/{projectId}/geo/visibility/competitors/{brand}"
                    ]
                  },
                  {
                    "group": "Content Gaps and Briefs",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/gaps",
                      "GET /v1/projects/{projectId}/geo/briefs",
                      "POST /v1/projects/{projectId}/geo/briefs",
                      "GET /v1/projects/{projectId}/geo/briefs/{briefId}",
                      "POST /v1/projects/{projectId}/geo/briefs/{briefId}/approve"
                    ]
                  },
                  {
                    "group": "Agent Readiness",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/agent-readiness",
                      "POST /v1/projects/{projectId}/geo/agent-readiness/scan"
                    ]
                  },
                  {
                    "group": "Traffic",
                    "expanded": true,
                    "pages": [
                      "GET /v1/projects/{projectId}/geo/traffic/overview",
                      "GET /v1/projects/{projectId}/geo/traffic/log",
                      "GET /v1/projects/{projectId}/geo/traffic/journeys",
                      "GET /v1/projects/{projectId}/geo/traffic/journeys/{journeyId}",
                      "GET /v1/projects/{projectId}/geo/traffic/pages"
                    ]
                  },
                  {
                    "group": "Traffic Ingest",
                    "expanded": true,
                    "pages": [
                      "GET /v1/geo/ingest/setup",
                      "POST /v1/geo/ingest/token",
                      "POST /v1/geo/ingest/rotate-token"
                    ]
                  }
                ]
              },
              {
                "group": "Agent",
                "expanded": true,
                "pages": [
                  "POST /v2/eve/v1/session",
                  "POST /v2/eve/v1/session/{sessionId}",
                  "GET /v2/eve/v1/session/{sessionId}/stream",
                  "GET /v2/agent-chats"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Discord Community",
          "href": "https://www.usenotra.com/discord",
          "icon": "discord"
        }
      ]
    }
  },
  "logo": {
    "light": "logo/notra-wordmark.svg",
    "dark": "logo/notra-wordmark-dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/usenotra/notra"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/usenotra",
      "github": "https://github.com/usenotra"
    }
  }
}
