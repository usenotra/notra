{
  "extends": "@notra/typescript-config/base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck.tsbuildinfo",
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "bun-types/test", "react", "react-dom", "vite/client"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ui/src/hooks/use-controllable-state.ts"
  ],
  "exclude": ["node_modules", ".output", ".vercel"]
}
