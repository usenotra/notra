{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bunx bun@1.4.0 install --frozen-lockfile --filter 'dashboard...' --filter turbo",
  "buildCommand": "bash scripts/vercel-build.sh",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/monitoring",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/geo-scan",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 8 * * *"
    }
  ]
}
