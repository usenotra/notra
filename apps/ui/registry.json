{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "notra",
  "homepage": "https://ui.usenotra.com",
  "items": [
    {
      "name": "marketing-button",
      "type": "registry:component",
      "title": "Marketing Button",
      "description": "The gradient marketing buttons from the Notra landing page, built on the Base UI Button.",
      "dependencies": ["class-variance-authority", "cn"],
      "cssVars": {
        "theme": {
          "color-marketing-light-foreground": "#1e1e1e",
          "tracking-marketing": "-0.015em"
        }
      },
      "files": [
        {
          "path": "registry/notra/marketing-button/components/marketing-button.tsx",
          "type": "registry:component"
        }
      ],
      "css": {
        "@property --marketing-gradient-from": {
          "syntax": "\"<color>\"",
          "inherits": "false",
          "initial-value": "oklab(100% 0 0)"
        },
        "@property --marketing-gradient-to": {
          "syntax": "\"<color>\"",
          "inherits": "false",
          "initial-value": "oklab(100% 0 0)"
        },
        "@utility marketing-gradient-primary": {
          "--marketing-gradient-from": "oklab(69.9% 0.067 -0.16)",
          "--marketing-gradient-to": "oklab(52.6% 0.113 -0.27)",
          "background-image": "linear-gradient(180deg, var(--marketing-gradient-from) 0%, var(--marketing-gradient-to) 100%)",
          "box-shadow": "#8b5cf640 0 0 0 0.5rem, #28282814 0 0.0625rem 0.125rem, #1e1e1e40 0 0 0 0.0625rem",
          "transition": "--marketing-gradient-from 200ms ease-out, --marketing-gradient-to 200ms ease-out",
          "&:hover": {
            "--marketing-gradient-to": "oklab(33.9% 0.073 -0.174)"
          },
          "&:active": {
            "--marketing-gradient-from": "oklab(52.6% 0.113 -0.27)",
            "--marketing-gradient-to": "oklab(24.8% 0.053 -0.127)"
          }
        },
        "@utility marketing-gradient-light": {
          "--marketing-gradient-from": "oklab(100% 0 0)",
          "--marketing-gradient-to": "oklab(95.5% 0 0)",
          "background-image": "linear-gradient(180deg, var(--marketing-gradient-from) 0%, var(--marketing-gradient-to) 100%)",
          "box-shadow": "#ececec 0 0 0 0.0625rem, #28282814 0 0.0625rem 0.125rem",
          "transition": "--marketing-gradient-from 200ms ease-out, --marketing-gradient-to 200ms ease-out",
          "&:hover": {
            "--marketing-gradient-to": "oklab(89% 0 0)"
          },
          "&:active": {
            "--marketing-gradient-from": "oklab(95.5% 0 0)",
            "--marketing-gradient-to": "oklab(85% 0 0)"
          }
        }
      }
    },
