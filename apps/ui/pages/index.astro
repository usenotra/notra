---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";

import DuotoneTooltip from "../src/components/duotone-tooltip.astro";
import HeroDither from "../src/components/hero-dither.astro";
import ThemeHotkey from "../src/components/theme-hotkey.astro";
import TooltipPreview from "../src/components/previews/tooltip-preview.astro";
import { LANDING_COMPONENTS } from "../src/constants/landing";

const { config, navigation } = data;
const previews = { tooltip: TooltipPreview };
const repoUrl = config.repoUrl ?? "https://github.com/usenotra/notra";
---

<PageLayout
  analytics={config.analytics}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={navigation}
  page={{
    description: config.description,
    route: "/",
    title: "Notra UI: the components behind Notra",
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  themeMode={config.theme.mode}
>
  <section class="mx-auto max-w-6xl px-6 pt-6 pb-16">
    <div class="relative isolate overflow-clip rounded-3xl bg-[#C8B2EE40] dark:bg-[#2a2140]">
    <HeroDither />
    <div class="relative grid items-center gap-12 px-8 py-16 sm:px-12 lg:grid-cols-[1.1fr_1fr] lg:py-24">
    <div class="flex flex-col gap-6">
      <h1 class="font-display text-5xl leading-[1.05] font-semibold tracking-tight text-foreground sm:text-6xl">
        The components<br />behind <span class="text-accent">Notra</span>
      </h1>
      <p class="max-w-md text-lg text-pretty text-muted-foreground">
        The building blocks of the Notra dashboard, documented and rendered live with the real styles.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          class="inline-flex h-10 items-center rounded-lg bg-accent px-5 text-sm font-medium text-accent-foreground no-underline transition-opacity hover:opacity-90"
          href="/introduction"
        >
          Get started
        </a>
        <a
          class="inline-flex h-10 items-center rounded-lg bg-white px-5 text-sm font-medium text-neutral-950 no-underline transition-opacity hover:opacity-90"
          href={repoUrl}
          rel="noopener"
          target="_blank"
        >
          View on GitHub
        </a>
      </div>
    </div>

    <div class="relative flex h-80 items-start justify-center overflow-hidden rounded-2xl border-2 border-border border-b-border/50 bg-background/70 shadow-sm pt-16 backdrop-blur-sm dot-grid">
      <DuotoneTooltip aside="Last 7 days" label="Weekly summary" open title="Visits">
        <span class="block text-2xl font-semibold tabular-nums text-foreground">12,480</span>
        <span class="mt-1 block">Up 18% on the previous week, led by returning readers.</span>
      </DuotoneTooltip>
    </div>
    </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-20">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-foreground">Components</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        LANDING_COMPONENTS.map((component) => {
          const Preview = previews[component.preview];
          return (
            <div class="group relative">
              <div
                class="pointer-events-none invisible absolute inset-x-0 bottom-full z-10 mb-3 flex h-56 translate-y-1 items-start justify-center overflow-hidden rounded-2xl border border-border bg-muted pt-6 opacity-0 dot-grid shadow-md transition duration-150 ease-out group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none"
                inert
              >
                <Preview />
              </div>
              <a
                class="flex flex-col gap-2 rounded-2xl border-2 border-border border-b-border/50 p-5 shadow-sm no-underline transition-colors hover:bg-muted/50"
                href={component.href}
              >
                <span class="text-sm font-semibold text-foreground">{component.title}</span>
                <span class="text-sm text-muted-foreground">{component.description}</span>
              </a>
            </div>
          );
        })
      }
    </div>
  </section>
  <ThemeHotkey slot="footer" />
</PageLayout>

