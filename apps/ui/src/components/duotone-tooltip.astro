---
import type { DuotoneTooltipProps as Props } from "../types/duotone-tooltip";

const { aside, label, open = false, title } = Astro.props;
const id = `duotone-tooltip-${crypto.randomUUID()}`;
---

<span class="group relative inline-flex">
  <button
    aria-describedby={id}
    class="rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground transition-colors hover:bg-muted"
    type="button"
  >
    {label}
  </button>
  <span
    class:list={[
      "pointer-events-none absolute top-full left-1/2 z-50 mt-2 w-72 -translate-x-1/2 text-left transition duration-150 ease-out",
      open
        ? "visible translate-y-0 opacity-100"
        : "invisible translate-y-1 opacity-0 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100",
    ]}
    id={id}
    role="tooltip"
  >
    <span class="block rounded-t-2xl border border-b-0 border-border bg-muted pb-5">
      <span class="flex items-center justify-between gap-3 px-3 py-2">
        <span class="truncate text-sm font-semibold text-foreground">{title}</span>
        {aside && <span class="shrink-0 text-xs tabular-nums text-muted-foreground">{aside}</span>}
      </span>
    </span>
    <span class="-mt-5 block rounded-2xl border border-border bg-background px-3 py-2.5 text-xs text-muted-foreground shadow-md">
      <slot />
    </span>
  </span>
</span>
