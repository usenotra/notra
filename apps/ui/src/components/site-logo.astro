---
import type { ComponentProps } from "astro/types";
import Logo from "blume/components/layout/Logo.astro";

type Props = ComponentProps<typeof Logo>;

const props = Astro.props;
---

<div class="flex min-w-0 items-center gap-2" data-site-brand>
  <Logo {...props} />
  <a
    class="inline-flex rounded-full px-3 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:text-foreground"
    href="/introduction"
  >
    Docs
  </a>
</div>
