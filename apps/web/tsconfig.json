{
  "extends": "@notra/typescript-config/react-library.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "types": ["vite/client", "node", "mdx", "bun-types/test"],
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "~types/*": ["./types/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".output", ".nitro", ".tanstack"]
}
