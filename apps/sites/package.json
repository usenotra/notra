{
  "name": "@notra/sites",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker that serves Notra Sites (hosted blogs and changelogs) from R2.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@notra/sites-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@notra/typescript-config": "workspace:*",
    "bun-types": "1.4.0",
    "typescript": "7.0.2",
    "wrangler": "^4.0.0"
  }
}
