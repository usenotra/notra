---
import type { CardGroupProps as Props } from "../types/builtins";
import { CARD_GROUP_GRID } from "../constants/builtins";

const cols = Math.min(Math.max(Number(Astro.props.cols ?? 2), 1), 4);
const grid = CARD_GROUP_GRID[cols];
---

<div class:list={["card-group columns not-prose my-6 grid gap-3", grid]}><slot /></div>
