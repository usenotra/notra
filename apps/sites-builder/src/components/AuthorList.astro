---
import type { AuthorListProps as Props } from "../types/authors";
import AuthorAvatar from "./AuthorAvatar.astro";

const { authors } = Astro.props;
const last = authors.length - 1;
---

{
  authors.length > 0 && (
    <div class="flex items-center gap-3">
      <div aria-hidden="true" class="flex shrink-0 -space-x-2">
        {authors.map((author) => (
          <AuthorAvatar author={author} size={32} loading="eager" class="ring-2 ring-(--page-background)" />
        ))}
      </div>
      <p class="text-[0.9375rem] text-muted-foreground">
        {authors.map((author, index) => (
          <>
            {index > 0 && (index === last ? " and " : ", ")}
            {author.href ? (
              <a href={author.href} class="font-medium text-foreground decoration-foreground/30 underline-offset-2 hover:underline">
                {author.name}
              </a>
            ) : (
              <span class="font-medium text-foreground">{author.name}</span>
            )}
          </>
        ))}
      </p>
    </div>
  )
}
