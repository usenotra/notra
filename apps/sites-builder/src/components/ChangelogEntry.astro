---
import type { ChangelogEntryProps as Props } from "../types/entries";
import { render } from "astro:content";
import { assetUrl, href } from "../lib/params";
import { formatDate, isoDate } from "../utils/dates";
import { excerpt } from "../utils/excerpt";
import Icon from "./Icon.astro";

const { entry, standalone = false, layout = "timeline" } = Astro.props;
const { Content } = await render(entry);
const Heading = standalone ? "h1" : "h2";
const anchor = entry.id.replaceAll("/", "-");
const image = assetUrl(entry.data.image);
const summary = layout === "compact" ? (entry.data.description ?? excerpt(entry.body)) : undefined;
---

{
  layout === "compact" && !standalone ? (
    <article id={anchor} class="group relative grid gap-1.5 py-5 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
      <div class="flex items-center gap-2 text-sm text-muted-foreground tabular-nums sm:flex-col sm:items-start sm:gap-1.5 sm:pt-0.5">
        <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        {entry.data.version && <span class="changelog-version">{entry.data.version}</span>}
      </div>
      <div class="flex max-w-(--layout-reading) min-w-0 items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="font-heading font-semibold tracking-[-0.015em] text-balance decoration-foreground/25 decoration-1 underline-offset-[0.2em] group-hover:underline">
            <a href={href(entry.id)} class="after:absolute after:inset-0">{entry.data.title}</a>
            {entry.data.draft && <span class="ml-2 align-middle text-sm font-normal text-warning">Draft</span>}
          </h2>
          {summary && <p class="mt-1 line-clamp-2 text-[0.9375rem] leading-6 text-pretty text-muted-foreground">{summary}</p>}
        </div>
        <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-muted-foreground transition-transform duration-150 ease-out group-hover:translate-x-0.5" />
      </div>
    </article>
  ) : layout === "cards" && !standalone ? (
    <article id={anchor} class="post-card grid gap-3 rounded-2xl border p-6 sm:p-8">
      <div class="flex items-center gap-2 text-sm text-muted-foreground tabular-nums">
        <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        {entry.data.version && <span class="changelog-version">{entry.data.version}</span>}
      </div>
      <div class="min-w-0">
        <h2 class="font-heading text-xl leading-snug font-semibold tracking-[-0.02em] text-balance">
          <a href={href(entry.id)} class="decoration-foreground/25 decoration-1 underline-offset-[0.2em] hover:underline">{entry.data.title}</a>
          {entry.data.draft && <span class="ml-2 align-middle text-sm font-normal tracking-normal text-warning">Draft</span>}
        </h2>
        {image && <img src={image} alt="" class="image-outline mt-5 w-full rounded-xl" loading="lazy" />}
        <div class="mdx-content prose prose-notra mt-4 max-w-none">
          <Content />
        </div>
      </div>
    </article>
  ) : (
    <article id={anchor}>
      <p class="post-meta flex flex-wrap items-center gap-x-2">
        <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        {entry.data.version && <span>· {entry.data.version}</span>}
        {entry.data.draft && <span class="text-warning">· Draft</span>}
      </p>
      <Heading id={standalone ? "page-title" : undefined} class="mt-3 font-heading text-[2rem] leading-[1.1] font-semibold tracking-[-0.035em] text-balance sm:text-[2.5rem]">
        {standalone ? entry.data.title : <a href={href(entry.id)} class="decoration-foreground/25 decoration-2 underline-offset-[0.15em] hover:underline">{entry.data.title}</a>}
      </Heading>
      {entry.data.description && <p class="mt-4 text-lg leading-8 text-pretty text-muted-foreground">{entry.data.description}</p>}
      {image && <img src={image} alt="" class="image-outline mt-8 w-full rounded-2xl" loading={standalone ? "eager" : "lazy"} />}
      <div class="mdx-content prose prose-notra mt-8 max-w-none" data-md-root={standalone ? "" : undefined}>
        <Content />
      </div>
    </article>
  )
}
