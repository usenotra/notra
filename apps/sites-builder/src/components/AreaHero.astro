---
import type { AreaHeroProps as Props } from "../types/areas";
import { heroOptions } from "../lib/options";
import { assetUrl, params } from "../lib/params";

const { title, description } = Astro.props;
const hero = heroOptions(params.area);
const image = hero.style === "image" ? assetUrl(hero.image) : undefined;
const style = hero.style === "image" && !image ? "plain" : hero.style;
const width = params.area === "changelog" ? "max-w-(--layout-reading)" : "max-w-(--layout-index)";
---

{
  style === "none" ? (
    <h1 id="page-title" class="sr-only">{title}</h1>
  ) : style === "image" ? (
    <section class:list={["hero-image relative isolate mx-auto w-full overflow-clip rounded-2xl", width]} style={`--hero-image:url(${JSON.stringify(image)})`}>
      <div class="flex min-h-72 flex-col justify-end gap-3 p-6 sm:min-h-80 sm:p-10">
        {hero.eyebrow && <p class="text-sm font-medium text-white/80">{hero.eyebrow}</p>}
        <h1 id="page-title" class="max-w-2xl font-heading text-4xl leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-5xl">{title}</h1>
        {description && <p class="max-w-xl text-base leading-7 text-pretty text-white/85 sm:text-lg">{description}</p>}
      </div>
    </section>
  ) : (
    <section class:list={["mx-auto w-full", width, style === "wash" && "hero-wash mt-4 rounded-2xl sm:mt-6"]}>
      <div class:list={["flex flex-col gap-3", style === "wash" ? "px-6 py-10 sm:px-10 sm:py-14" : "pt-4 sm:pt-8 lg:pt-10"]}>
        {hero.eyebrow && <p class="text-sm font-medium text-primary">{hero.eyebrow}</p>}
        <h1 id="page-title" class="max-w-2xl font-heading text-4xl leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-5xl">{title}</h1>
        {description && <p class="max-w-xl text-base leading-7 text-pretty text-muted-foreground sm:text-lg">{description}</p>}
      </div>
    </section>
  )
}
