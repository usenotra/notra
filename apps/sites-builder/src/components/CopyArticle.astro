---
import type { CopyArticleProps as Props } from "../types/contextual";
import { contextualActions } from "../lib/contextual";
import Icon from "./Icon.astro";
import LinkIcon from "./LinkIcon.astro";

const { markdownHref, pagePath, title } = Astro.props;
const { copy, menu } = contextualActions({ title, pagePath, markdownHref });
---

{
  copy && (
    <>
      <span aria-hidden="true">·</span>
      <button type="button" data-copy-article={markdownHref} class="inline-flex cursor-pointer items-center gap-1.5 underline-offset-4 transition-colors duration-150 hover:text-foreground hover:underline">
        <Icon name="copy" size={14} class="[[data-copied]_&]:hidden" />
        <Icon name="check" size={14} class="hidden [[data-copied]_&]:block" />
        <span data-copy-label>Copy article</span>
      </button>
    </>
  )
}
{
  menu.length > 0 && (
    <>
      <span aria-hidden="true">·</span>
      <details class="group relative" data-open-in>
        <summary aria-label="Open in" class="flex cursor-pointer list-none items-center gap-1 underline-offset-4 transition-colors duration-150 hover:text-foreground hover:underline [&::-webkit-details-marker]:hidden">
          Open in
          <Icon name="chevron-down" size={14} class="transition-transform duration-150 group-open:rotate-180" />
        </summary>
        <div
          class:list={[
            "absolute left-0 z-30 mt-2 origin-top-left rounded-xl border border-border bg-background p-1.5 font-sans shadow-lg motion-safe:animate-[menu-in_120ms_ease-out]",
            menu.some((item) => item.description) ? "w-72" : "w-60",
          ]}
        >
          {menu.map((item, index) => (
            <>
              {index > 0 && menu[index - 1]?.kind !== item.kind && <div class="my-1 h-px bg-border" />}
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="flex items-center gap-3 rounded-lg px-2.5 py-2 text-sm text-foreground transition-colors duration-150 hover:bg-muted"
              >
                {item.logo ? (
                  <span class="flex size-5 shrink-0 items-center justify-center [&>svg]:size-4" set:html={item.logo} />
                ) : (
                  <span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
                    <LinkIcon icon={item.icon} size={16} />
                  </span>
                )}
                <span class="flex min-w-0 flex-col">
                  <span>{item.label}</span>
                  {item.description && <span class="text-xs leading-snug text-muted-foreground">{item.description}</span>}
                </span>
                {item.external && <Icon name="arrow-up-right" size={13} class="ml-auto shrink-0 text-muted-foreground" />}
              </a>
            </>
          ))}
        </div>
      </details>
    </>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-article]")) {
    button.addEventListener("click", async () => {
      const response = await fetch(button.dataset.copyArticle ?? "");
      if (!response.ok) {
        return;
      }
      await navigator.clipboard.writeText(await response.text());
      const label = button.querySelector("[data-copy-label]");
      button.setAttribute("data-copied", "");
      if (label) {
        label.textContent = "Copied";
      }
      setTimeout(() => {
        button.removeAttribute("data-copied");
        if (label) {
          label.textContent = "Copy article";
        }
      }, 2000);
    });
  }
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-open-in]")) {
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.open = false;
      }
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
