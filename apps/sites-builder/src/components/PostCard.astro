---
import { authorsOf, type BlogEntry, formatDate, isoDate } from "../lib/entries";
import { assetUrl, href } from "../lib/params";
import PostCover from "./PostCover.astro";

interface Props {
  entry: BlogEntry;
  headingLevel?: "h2" | "h3";
}

const { entry, headingLevel: Heading = "h2" } = Astro.props;
const authors = authorsOf(entry);
---

<a href={href(entry.id)} class="group flex flex-col">
  <PostCover image={assetUrl(entry.data.image)} class="aspect-[16/10] rounded-xl" />
  <p class="mt-4 text-[0.8125rem] text-muted-foreground tabular-nums">
    <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
    {authors.length > 0 && <span> · {authors.join(", ")}</span>}
    {entry.data.draft && <span class="text-warning"> · Draft</span>}
  </p>
  <Heading class="mt-1.5 font-medium text-balance decoration-muted-foreground/40 underline-offset-4 group-hover:underline">{entry.data.title}</Heading>
  {entry.data.description && <p class="mt-1 line-clamp-2 text-sm leading-6 text-pretty text-muted-foreground">{entry.data.description}</p>}
</a>
