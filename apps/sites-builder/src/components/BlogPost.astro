---
import { render } from "astro:content";
import { authorsOf } from "../lib/authors";
import { getBlogEntries } from "../lib/entries";
import { blogOptions } from "../lib/options";
import { assetUrl, config, href, markdownHref } from "../lib/params";
import { slotPost } from "../lib/slot-data";
import { slotComponent } from "../lib/site-files";
import type { BlogEntry } from "../types/entries";
import { formatDate, isoDate } from "../utils/dates";
import { readingMinutes } from "../utils/reading-time";
import AuthorList from "./AuthorList.astro";
import CopyArticle from "./CopyArticle.astro";
import Icon from "./Icon.astro";
import PostPagination from "./PostPagination.astro";
import SiteSlot from "./SiteSlot.astro";
import Toc from "./Toc.astro";

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const options = blogOptions.post;
const image = assetUrl(entry.data.image);
const authors = options.authorCard ? authorsOf(entry) : [];
const updated =
  config.metadata.timestamp && entry.data.updated && isoDate(entry.data.updated) !== isoDate(entry.data.date) ? entry.data.updated : undefined;
const entries = options.pagination ? await getBlogEntries() : [];
const index = entries.findIndex((other) => other.id === entry.id);
const next = index > 0 ? entries[index - 1] : undefined;
const previous = index >= 0 ? entries[index + 1] : undefined;
const post = slotPost(entry);
const hasSidebarSlot = Boolean(slotComponent("sidebar"));
const wide = options.width === "wide" && (authors.length > 0 || options.toc || hasSidebarSlot);
---

<article
  class:list={[
    "mx-auto grid w-full grid-cols-1 gap-x-16 gap-y-6 pt-10 sm:pt-16 lg:pt-20 [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24",
    wide ? "max-w-(--layout-post) lg:grid-cols-[minmax(0,1fr)_16rem]" : "max-w-(--layout-reading)",
  ]}
>
  <header id="header" class="min-w-0 lg:col-start-1 lg:row-start-1">
    <a href={href()} class="group mb-6 inline-flex items-center gap-2 font-mono text-sm text-muted-foreground transition-colors duration-150 hover:text-foreground">
      <Icon name="arrow-left" size={16} class="transition-transform duration-150 group-hover:-translate-x-0.5" />
      Back to blog
    </a>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-foreground/75">
      <time datetime={isoDate(entry.data.date)}>Published {formatDate(entry.data.date)}</time>
      {updated && <span>· Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>}
      {options.readingTime && <span class="whitespace-nowrap">· {readingMinutes(entry.body)} min read</span>}
      {entry.data.draft && <span class="text-warning">· Draft</span>}
      <CopyArticle markdownHref={markdownHref(href(entry.id))} pagePath={href(entry.id)} title={entry.data.title} />
    </div>
    <h1 id="page-title" class="mt-6 mb-4 max-w-3xl font-heading text-4xl leading-[1.05] font-medium tracking-[-0.02em] text-balance sm:text-5xl">{entry.data.title}</h1>
    {!wide && authors.length > 0 && <div class="mt-6"><AuthorList authors={authors} /></div>}
  </header>

  {
    wide && (
      <aside class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:pt-12">
        <AuthorList authors={authors} />
        {(options.toc || hasSidebarSlot) && (
          <div class:list={["sticky top-8 flex-col gap-8", hasSidebarSlot ? "flex" : "hidden lg:flex", authors.length > 0 && "mt-8"]}>
            {options.toc && (
              <div class="hidden lg:block">
                <Toc headings={headings} />
              </div>
            )}
            <SiteSlot name="sidebar" data={{ post }} />
          </div>
        )}
      </aside>
    )
  }

  <div class="min-w-0 border-t border-border pt-6 lg:col-start-1 lg:row-start-2">
    <SiteSlot name="before-post" data={{ post }} class="mb-8" />
    {image && <img src={image} alt="" class="image-outline mt-2 mb-8 aspect-[16/9] w-full rounded-2xl object-cover" loading="eager" />}
    <div class="mdx-content prose prose-notra max-w-none" data-md-root>
      <Content />
    </div>
    <SiteSlot name="after-post" data={{ post }} class="mt-12" />
    {!wide && <SiteSlot name="sidebar" data={{ post }} class="mt-12" />}
    {options.pagination && <PostPagination next={next} previous={previous} />}
  </div>
</article>
