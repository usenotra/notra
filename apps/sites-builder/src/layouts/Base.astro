---
import type { BaseLayoutProps as Props } from "../types/seo";
import "../styles/global.css";
import "@notra/custom-css";
import Banner from "../components/Banner.astro";
import CodeBlocks from "../components/CodeBlocks.astro";
import CustomChrome from "../components/CustomChrome.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteBanner } from "../lib/banner";
import { THEME_AREAS } from "../constants/areas";
import { absoluteUrl, areaTitle, config, llmsHref, namedAreaTitle, params } from "../lib/params";
import { extraMetaTags, socialImage, structuredData, themeColors, touchIcon, twitterHandle } from "../lib/seo";
import { chromeComponent } from "../lib/site-files";
import { decorationClass, faviconFor, fontFaces, fontStylesheetUrl, themeStyle } from "../lib/theme";
import { mountPath } from "../utils/paths";

const { title, description, image, generatedImage, type = "website", noindex = false, publishedTime, modifiedTime, tags = [], markdown, jsonLd } = Astro.props;
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : Astro.url.pathname;
const canonical = absoluteUrl(canonicalPath);
const ogImage = socialImage(image, generatedImage);
const robots = params.noindex || noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const twitterSite = twitterHandle();
const colors = themeColors();
const appleTouchIcon = touchIcon();
const feeds = THEME_AREAS.flatMap((area) => {
  const mount = params.mounts[area];
  return mount ? [{ title: namedAreaTitle(area), href: mountPath(mount, "feed.xml") }] : [];
});
const fontsUrl = fontStylesheetUrl();
const appearance = config.appearance;
const codeDark = config.styling.codeblocks === "dark";
const lightFavicon = faviconFor("light");
const darkFavicon = faviconFor("dark");
const metaTags = extraMetaTags();
const banner = siteBanner();
const dismissKey = banner?.dismissible ? banner.storageKey : null;
const customHeader = Boolean(chromeComponent("header"));
const customFooter = Boolean(chromeComponent("footer"));
---

<!doctype html>
<html lang="en" class:list={[decorationClass(), codeDark && "code-dark"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {lightFavicon && <link rel="icon" href={lightFavicon} media={darkFavicon !== lightFavicon ? "(prefers-color-scheme: light)" : undefined} />}
    {darkFavicon && darkFavicon !== lightFavicon && <link rel="icon" href={darkFavicon} media="(prefers-color-scheme: dark)" />}
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    <meta name="theme-color" content={colors.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={colors.dark} media="(prefers-color-scheme: dark)" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href={llmsHref()} />
    {feeds.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />)}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={config.name} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage.url} />}
    {ogImage && <meta property="og:image:alt" content={ogImage.large ? title : config.name} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && <meta property="article:section" content={areaTitle(params.area)} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={ogImage?.large ? "summary_large_image" : "summary"} />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    <meta name="generator" content="Notra Sites" />
    {metaTags.map((tag) => (tag.key === "property" ? <meta property={tag.value} content={tag.content} /> : <meta name={tag.value} content={tag.content} />))}
    {jsonLd && <script type="application/ld+json" set:html={structuredData(jsonLd)} />}
    {fontsUrl && <link rel="stylesheet" href={fontsUrl} />}
    <style is:inline set:html={`${fontFaces()}${themeStyle()}`}></style>
    <script is:inline define:vars={{ appearance }}>
      const stored = appearance.strict ? null : localStorage.getItem("notra-theme");
      const mode = stored ?? appearance.default;
      const dark = mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
    </script>
    {
      dismissKey && (
        <script is:inline define:vars={{ dismissKey }}>
          if (localStorage.getItem(dismissKey)) {
            document.documentElement.setAttribute("data-banner-dismissed", "");
          }
        </script>
      )
    }
    <slot name="head" />
    {
      params.headScripts.map((script) =>
        script.kind === "external" ? <script is:inline src={script.src} {...script.attributes} /> : <script is:inline set:html={script.code} />
      )
    }
  </head>
  <body id="body-content" class="flex min-h-dvh flex-col font-sans text-foreground">
    <a href="#content-area" class="skip-link">Skip to content</a>
    {banner && <Banner banner={banner} />}
    {customHeader ? <CustomChrome part="header" /> : <Header />}
    <main id="content-area" tabindex="-1" class="w-full flex-1 px-4 pt-4 pb-24 outline-none sm:px-6 sm:pt-6">
      <div id="content"><slot /></div>
    </main>
    {customFooter ? <CustomChrome part="footer" /> : <Footer />}
    <CodeBlocks />
  </body>
</html>
