{
  "version": 1,
  "contract": "Push each raw line at evaluationTime - ageSeconds with its stream labels to a disposable pinned Loki. For every comparison query, interpolate environment, organization, $__range and $__auto from each selection, execute both baseline and dashboard target as instant queries at evaluationTime, and compare sorted complete label/value results (floating-point tolerance 1e-9). Reject result labels outside the expected grouping; neither path may return __error__. These fixtures are not production data. Raw lines deliberately include malformed and escaped-key JSON; do not reserialize them before pushing.",
  "expectationContract": "Each expectation names a dashboard and exact panel/ref targets, complete instant vectors and explicit selections. Execute each target for every listed selection and compare against its independently stated vector. Expected values are not calculated from events or dashboard queries. The same contract applies to surface-query-fixtures.json.",
  "parserSemantics": "API grouping fixtures retain representative missing/null/empty labels because native and explicit JSON parsing differ there. Other domains reuse that parser behavior rather than repeating the permutation matrix. Cost fixtures independently exercise repeated IDs, missing identifiers, unknown/invalid numerics and customer filtering; runtime fixtures preserve latest-sample zero.",
  "range": "5m",
  "selections": [
    { "environment": "validation", "organization": ".*" },
    { "environment": "validation", "organization": "org_beta" },
    { "environment": "production", "organization": ".*" }
  ],
  "comparisons": [
    {
      "dashboard": "notra-overview",
      "panelId": 6,
      "refId": "A",
      "grouping": ["routeId"],
      "baseline": "sum by (routeId) (rate({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"api.request.completed\" | organizationId=~\"${organization:raw}\" | __error__=\"\" [$__auto]))"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 7,
      "refId": "A",
      "grouping": ["routeId"],
      "baseline": "quantile_over_time(0.95, {service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"api.request.completed\" | organizationId=~\"${organization:raw}\" | unwrap durationMs | __error__=\"\" [$__auto]) by (routeId)"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 8,
      "refId": "A",
      "grouping": ["routeId"],
      "baseline": "sum by (routeId) (rate({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"api.request.completed\" | organizationId=~\"${organization:raw}\" | status >= 500 | __error__=\"\" [$__auto]))"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 9,
      "refId": "A",
      "grouping": ["model", "event"],
      "baseline": "sum by (model,event) (rate({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=~\"ai.call.(completed|failed|aborted|incomplete)\" | organizationId=~\"${organization:raw}\" | __error__=\"\" [$__auto]))"
    },
    {
      "dashboard": "notra-accounting",
      "panelId": 10,
      "refId": "A",
      "grouping": [],
      "baseline": "sum(max by (costId) (max_over_time({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.cost.reported\" | organizationId=~\"${organization:raw}\" | costId!=\"\" | unwrap gatewayCostUsd | __error__=\"\" [$__range])))"
    },
    {
      "dashboard": "notra-accounting",
      "panelId": 11,
      "refId": "A",
      "grouping": [],
      "baseline": "sum(max by (costId) (max_over_time({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.cost.reported\" | organizationId=~\"${organization:raw}\" | costId!=\"\" | unwrap byokInferenceCostUsd | __error__=\"\" [$__range])))"
    },
    {
      "dashboard": "notra-accounting",
      "panelId": 12,
      "refId": "A",
      "grouping": ["gateway"],
      "baseline": "last_over_time({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.router.credits\" | unwrap balance | __error__=\"\" [$__range]) by (gateway)"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 13,
      "refId": "A",
      "grouping": ["model"],
      "baseline": "sum by (model) (rate({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.call.completed\" | organizationId=~\"${organization:raw}\" | unwrap ai_totalTokens | __error__=\"\" [$__auto]))"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 14,
      "refId": "A",
      "grouping": ["model"],
      "baseline": "quantile_over_time(0.95, {service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.call.completed\" | organizationId=~\"${organization:raw}\" | unwrap ai_msToFirstChunk | __error__=\"\" [$__auto]) by (model)"
    },
    {
      "dashboard": "notra-overview",
      "panelId": 15,
      "refId": "A",
      "grouping": ["outcome", "reason"],
      "baseline": "sum by (outcome,reason) (rate({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"geo.ingest\" | organizationId=~\"${organization:raw}\" | unwrap weight | __error__=\"\" [$__auto]))"
    },
    {
      "dashboard": "notra-accounting",
      "panelId": 16,
      "refId": "A",
      "grouping": ["organizationId"],
      "baseline": "topk(20, sum by (organizationId) (count_over_time({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"api.request.completed\" | organizationId=~\"${organization:raw}\" | organizationId!=\"\" | __error__=\"\" [$__range])))"
    },
    {
      "dashboard": "notra-accounting",
      "panelId": 18,
      "refId": "A",
      "grouping": ["organizationId"],
      "baseline": "topk(20, sum by (organizationId) (max by (organizationId,costId) (max_over_time({service_name=~\".+\", deployment_environment_name=\"${environment}\"} | json | event=\"ai.cost.reported\" | organizationId=~\"${organization:raw}\" | organizationId!=\"\" | costId!=\"\" | unwrap costUsd | __error__=\"\" [$__range]))))"
    }
  ],
  "streams": [
