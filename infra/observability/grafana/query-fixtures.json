          "panelId": 10,
          "refId": "A",
          "grouping": [],
          "vector": [{ "metric": {}, "value": [0, 1] }]
        },
        {
          "panelId": 11,
          "refId": "A",
          "grouping": [],
          "vector": [{ "metric": {}, "value": [0, 2] }]
        },
        {
