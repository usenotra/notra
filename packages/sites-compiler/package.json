{
  "name": "@notra/sites-compiler",
  "version": "0.0.1",
  "private": true,
  "description": "Validates and transforms Notra Sites MDX/JSX without executing it. Used by the build toolchain and the dashboard.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./types/*": "./src/types/*.ts",
    "./constants/*": "./src/constants/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@notra/sites-core": "workspace:*",
    "acorn": "8.18.0",
    "acorn-jsx": "5.3.2",
    "estree-util-visit": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "@types/estree": "1.0.9",
    "@types/mdast": "4.0.4",
    "bun-types": "1.4.0",
    "typescript": "7.0.2"
  }
}
