{
  "extends": "@notra/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@notra/ai/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "bun-types/test"]
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
