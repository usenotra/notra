{
  "name": "@usenotra/geo",
  "version": "0.6.0",
  "private": false,
  "description": "Request capture SDK for AI traffic attribution and agent feedback collection",
  "keywords": [
    "agents",
    "ai",
    "analytics",
    "astro",
    "attribution",
    "crawler",
    "edge",
    "feedback",
    "geo",
    "llms.txt",
    "mcp",
    "netlify",
    "nextjs",
    "nuxt",
    "sveltekit",
    "tanstack"
  ],
  "homepage": "https://github.com/usenotra/notra/tree/main/packages/geo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/notra.git",
    "directory": "packages/geo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./netlify": {
      "types": "./dist/netlify.d.ts",
      "default": "./dist/netlify.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "default": "./dist/sveltekit.js"
    },
    "./signatures": {
      "types": "./dist/signatures.d.ts",
      "default": "./dist/signatures.js"
    },
    "./classify": {
      "types": "./dist/classify.d.ts",
      "default": "./dist/classify.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test tests",
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "@tanstack/react-start": "1.168.51",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
