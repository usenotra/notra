{
  "name": "@notra/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./constants/*": "./src/constants/*.ts",
    "./drizzle": "./src/drizzle.ts",
    "./drizzle-http": "./src/drizzle-http.ts",
    "./schema": "./src/schema.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "seed:brand-identity": "bun run src/scripts/seed-brand-identity.ts",
    "seed:chat-attachments": "bun run src/scripts/seed-chat-attachments.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.8",
    "effect": "4.0.0-rc.112",
    "typescript": "5.9.2"
  }
}
