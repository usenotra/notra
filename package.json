{
  "name": "turbo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "check-types": "dotenv -- turbo run check-types",
    "test": "turbo run test",
    "knip": "dotenv -- turbo run knip --filter=web --filter=dashboard --filter=api",
    "db:generate": "dotenv -- bunx drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "turbo run check:migrations --filter=@notra/db --",
    "db:migrate": "dotenv -- bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:push": "dotenv -- bunx drizzle-kit push --config packages/db/drizzle.config.ts",
    "db:studio": "dotenv -- bunx drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:drop": "dotenv -- bunx drizzle-kit drop --config packages/db/drizzle.config.ts",
    "db:pull": "dotenv -- bunx drizzle-kit pull --config packages/db/drizzle.config.ts",
    "evals": "bun --cwd apps/evals src/index.tsx",
    "devtools:api": "cd apps/api && bunx @ai-sdk/devtools",
    "devtools:dashboard": "cd apps/dashboard && bunx @ai-sdk/devtools",
    "check": "bun run check:effect && ultracite check --threads=4",
    "check:effect": "oxlint --config oxlint.effect.config.ts packages/tools/src packages/geo-core/src --threads=2",
    "format": "ultracite fix --threads=4",
    "format:unsafe": "ultracite fix --unsafe --threads=4",
    "commitlint": "commitlint",
    "prepare": "husky && ./scripts/prepare-effect.sh && effect-tsgo patch --no-typescript --oxlint",
    "brew:setup": "dotenv -- bun packages/email/scripts/brew-setup.ts",
    "brew:test-send": "dotenv -- bun packages/email/scripts/brew-test-send.tsx"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/tsgo": "0.47.2",
    "@shadcn/lint": "0.1.0",
    "@types/node": "24.13.2",
    "bun-types": "1.4.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "knip": "^6.12.2",
    "openlogs": "^0.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.11.4",
    "typescript": "7.0.2",
    "ultracite": "7.10.6"
  },
  "overrides": {
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.7",
    "dompurify": "3.4.12",
    "hono": "4.12.30",
    "js-yaml@3": "3.15.0",
    "nf3": "0.3.17",
    "protobufjs@7": "7.6.5",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "evlog@2.28.1": "patches/evlog@2.28.1.patch"
  }
}
